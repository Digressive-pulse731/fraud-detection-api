# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=frauddb
DB_USER=fraud
DB_PASSWORD=change-me

# Kafka (kafka:19092 inside Docker; use localhost:9092 when running on the host)
KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# Dashboard: API base URL (http://app:8000 inside Docker, http://localhost:8000 on the host)
API_URL=http://app:8000

# Producer feed simulation (0 = stream the full dataset)
PRODUCER_LIMIT=100
PRODUCER_INTERVAL=1.0

# Telegram fraud alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Risk score cutoff (0..1) above which a transaction triggers an alert
FRAUD_THRESHOLD=0.7
